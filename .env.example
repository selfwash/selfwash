AWS_REGION=eu-north-1
SQS_QUEUE_URL=https://sqs.eu-north-1.amazonaws.com/846497880886/SelfWash-Main-Queue

# Optional if not using ~/.aws/credentials or IAM role on EC2/Lambda:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- SQL ---
# Default (no DATABASE_URL): sqlite:///./transactions.db in this folder
#
# PostgreSQL (Docker Compose in this repo):
#   POSTGRES_USER=selfwash
#   POSTGRES_PASSWORD=strong-password-here
#   POSTGRES_DB=selfwash
#   POSTGRES_PORT=5432
#   DATABASE_URL=postgresql+psycopg://selfwash:strong-password-here@localhost:5432/selfwash
#
# AWS RDS / other cloud: use the endpoint they give you, e.g.
#   DATABASE_URL=postgresql+psycopg://USER:PASS@selfwash.xxxx.eu-north-1.rds.amazonaws.com:5432/selfwash
#
# --- Railway ---
# Add a PostgreSQL service; Railway injects DATABASE_URL (postgres://...).
# In the worker service Variables, also set: AWS_REGION, SQS_QUEUE_URL, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# Optional if SSL errors on unusual hosts: PGSSLMODE=require

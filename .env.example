# One variable per line. The value is everything after "=" until end of line — do not put "# ..." on the
# same line as a secret (unless the whole value is in double quotes). Put DATABASE_URL on a new line.

AWS_REGION=eu-north-1
SQS_QUEUE_URL=https://sqs.eu-north-1.amazonaws.com/846497880886/SelfWash-Main-Queue

# Optional if not using ~/.aws/credentials or IAM role on EC2/Lambda:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- SQL ---
# Default (no DATABASE_URL): sqlite:///./transactions.db in this folder
#
# PostgreSQL (Docker Compose in this repo):
#   POSTGRES_USER=selfwash
#   POSTGRES_PASSWORD=strong-password-here
#   POSTGRES_DB=selfwash
#   POSTGRES_PORT=5432
#   DATABASE_URL=postgresql+psycopg://selfwash:strong-password-here@localhost:5432/selfwash
#
# AWS RDS / other cloud: use the endpoint they give you, e.g.
#   DATABASE_URL=postgresql+psycopg://USER:PASS@selfwash.xxxx.eu-north-1.rds.amazonaws.com:5432/selfwash
#
# --- Railway (one service: consumer + API together) ---
# 1) New → Database → PostgreSQL (create the plugin).
# 2) Open your app service → Variables → New Variable → Reference → Postgres → DATABASE_URL.
# 3) Redeploy. (db.py requires DATABASE_URL on Railway; SQLite is not allowed there.)
#    On startup, init_db() runs Postgres SQL in migrations/*.sql (e.g. bigint widen). Or run manually:
#    psql "$DATABASE_URL" -f migrations/20250404_bigint_external_ids.sql
# docker-entrypoint.sh runs uvicorn + consumer.py against the same DATABASE_URL.
# Also set: AWS_REGION, SQS_QUEUE_URL, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, CORS_ORIGINS, optional READ_API_KEY
# Optional if SSL errors on unusual hosts: PGSSLMODE=require
#
# --- Auth (users, permissions) ---
# READ_API_KEY=long-random-string   # optional; if set, X-API-Key grants full access (service / automation)
# JWT_SECRET=long-random-string     # required for POST /api/auth/login and Bearer token access
# JWT_EXPIRE_MINUTES=10080
# If the DB has no users, optional one-time superuser (password hashed on first startup):
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=change-me-now
# Permissions (grant per user via admin API; superuser has all): nayax.read, machines.read, machines.write, admin.users
#
# Signup: POST /api/auth/register (pending until admin approves). Optional notify URL (JSON POST on each signup):
# SIGNUP_NOTIFY_WEBHOOK_URL=https://hooks.example.com/selfwash-signup
# SIGNUP_NOTIFY_WEBHOOK_SECRET= shared-secret   # optional header X-Webhook-Secret for your receiver
# ALLOW_PUBLIC_SIGNUP=1   # set to 0 to disable /api/auth/register
#
# CORS_ORIGINS=https://your-app.lovable.app,https://your-custom-domain.com
# CORS_LOVABLE_REGEX=1  # default: allow Lovable preview (*.lovableproject.com) and *.lovable.app via regex; set 0 to disable
#
# Optional callback auth for VMT pushes to POST /api/machines/callback
# VMT_CALLBACK_TOKEN=shared-secret-sent-as-X-Callback-Token
#
# API examples (after you have a public Railway URL):
#   GET /api/meta
#   GET /api/transactions?from_date=2026-04-01&to_date=2026-04-30&limit=100
#   GET /api/transactions?since=2026-04-05T10:00:00Z&order=asc&limit=50   # live polling
#   GET /api/transactions?include_payload=true&include_products=true&limit=20
#   GET /api/stats/summary?from_date=2026-04-01&to_date=2026-04-30
